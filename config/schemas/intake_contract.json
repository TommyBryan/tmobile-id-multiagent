{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "IntakeOutputContract",
	"type": "object",
	"properties": {
		"request_id": {
			"type": "string",
			"description": "OnPoint request/case ID"
		},
		"request_type": {
			"type": "string",
			"description": "Category of request",
			"enum": [
				"Capability Gap",
				"Content Update",
				"Compliance",
				"Event/Cohort Administration",
				"Learner Assignment",
				"Communication",
				"Reporting/Analytics",
				"Other"
			]
		},
		"business_problem_as_stated": {
			"type": "string",
			"description": "Restate the requester's business problem without diagnosing it"
		},
		"target_population": {
			"type": "string",
			"description": "Role(s), business unit, population/headcount if known"
		},
		"requested_date": {
			"type": "string",
			"format": "date",
			"description": "Target completion date in YYYY-MM-DD format"
		},
		"urgency_score": {
			"type": "integer",
			"minimum": 1,
			"maximum": 5
		},
		"business_impact_score": {
			"type": "integer",
			"minimum": 1,
			"maximum": 5
		},
		"duplicate_case_flag": {
			"type": "boolean"
		},
		"duplicate_candidates": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"case_id": {
						"type": "string"
					},
					"reason": {
						"type": "string"
					},
					"confidence": {
						"type": "number",
						"minimum": 0,
						"maximum": 1
					}
				},
				"required": [
					"case_id",
					"reason",
					"confidence"
				],
				"additionalProperties": false
			}
		},
		"routing_decision": {
			"type": "string",
			"enum": [
				"Discovery Agent",
				"Content Iteration Agent",
				"Scheduler/Batch Agent",
				"Notification/Nudge Agent",
				"Analytics & Impact Agent",
				"Human Review"
			]
		},
		"missing_information": {
			"type": "array",
			"items": {
				"type": "string"
			}
		},
		"discovery_ready": {
			"type": "boolean"
		},
		"evidence": {
			"type": "array",
			"items": {
				"type": "string"
			}
		},
		"confidence": {
			"type": "number",
			"minimum": 0,
			"maximum": 1
		},
		"routing_rationale": {
			"type": "string",
			"description": "Concise non-diagnostic rationale for routing"
		}
	},
	"required": [
		"request_id",
		"request_type",
		"business_problem_as_stated",
		"target_population",
		"requested_date",
		"urgency_score",
		"business_impact_score",
		"duplicate_case_flag",
		"duplicate_candidates",
		"routing_decision",
		"missing_information",
		"discovery_ready",
		"evidence",
		"confidence",
		"routing_rationale"
	],
	"additionalProperties": false
}
