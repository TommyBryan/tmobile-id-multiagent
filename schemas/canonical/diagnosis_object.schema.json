{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "## 5. Learner/Org Context (from Learner Data Agent) JSON Schema",
  "type": "object",
  "properties": {
    "diagnosis_id": {
      "type": "string",
      "description": "Enter diagnosis ID"
    },
    "request_id": {
      "type": "string",
      "description": "Enter request/OnPoint case ID"
    },
    "business_problem": {
      "type": "string",
      "description": "Business problem supported by intake/transcript evidence"
    },
    "business_outcome": {
      "type": "string",
      "description": "Business outcome that is not occurring"
    },
    "target_population": {
      "type": "string",
      "description": "Affected role population"
    },
    "current_performance": {
      "type": "string",
      "description": "Observable current behavior/performance"
    },
    "desired_performance": {
      "type": "string",
      "description": "Observable desired behavior/performance"
    },
    "performance_gap": {
      "type": "string",
      "description": "Difference between current and desired performance"
    },
    "root_causes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "knowledge | skill | motivation | process | tools_technology | environment | leadership | communication | policy | role_clarity | incentives | mixed | insufficient_evidence"
          },
          "finding": {
            "type": "string",
            "description": "Evidence-grounded root-cause finding"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Evidence reference"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "type",
          "finding",
          "evidence",
          "confidence"
        ],
        "additionalProperties": false
      }
    },
    "capability_gap_type": {
      "type": "string",
      "description": "Gap classification"
    },
    "learning_intervention_required": {
      "type": "boolean"
    },
    "non_learning_interventions": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Required non-learning action, or None"
      }
    },
    "initial_success_measures": {
      "type": "object",
      "properties": {
        "L1": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Reaction criterion"
          }
        },
        "L2": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Learning criterion"
          }
        },
        "L3": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Behavior criterion"
          }
        },
        "L4": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Business-result criterion"
          }
        }
      },
      "required": [
        "L1",
        "L2",
        "L3",
        "L4"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Verified evidence/source reference"
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Conflicting evidence/assertion, or None"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Explicit assumption, or None"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Question requiring clarification, or None"
      }
    },
    "overall_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "recommended_next_step": {
      "type": "string",
      "description": "PROCEED | HITL | REDIRECT + rationale"
    }
  },
  "required": [
    "diagnosis_id",
    "request_id",
    "business_problem",
    "business_outcome",
    "target_population",
    "current_performance",
    "desired_performance",
    "performance_gap",
    "root_causes",
    "capability_gap_type",
    "learning_intervention_required",
    "non_learning_interventions",
    "initial_success_measures",
    "evidence",
    "contradictions",
    "assumptions",
    "open_questions",
    "overall_confidence",
    "recommended_next_step"
  ],
  "additionalProperties": false
}
